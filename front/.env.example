# フロントエンド（Next.js）の環境変数。cp front/.env.example front/.env.local で作る

# 開発時（NODE_ENV=development）に呼ぶ API の URL
NEXT_PUBLIC_DEV_URL=http://localhost:3000

# 本番ビルド・テストで呼ぶ API の URL
NEXT_PUBLIC_API_URL=https://your-production-backend.onrender.com

# トップページの「お問い合わせフォーム」ボタンの外部 URL（未設定ならボタンは機能しない）
# NEXT_PUBLIC_CONTACT_FORM_URL=
