# バックエンド（Rails）の環境変数。cp back/.env.example back/.env で作る（dotenv-rails が開発・テストで読む）
# Docker Compose で起動する場合、DB_HOST / DB_PORT は compose.yml が上書きする

# JWT の署名鍵。開発・テストでは未設定でも動く（固定の開発用鍵にフォールバック）。本番は必須
# openssl rand -hex 64 などで生成する
JWT_SECRET=

# Google ログイン（OAuth2）。Google Cloud Console で作成し、
# 承認済みリダイレクト URI に http://localhost:3000/api/v1/auth/google/callback を登録する
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# フロントの URL。CORS の許可元、Google ログイン後の戻り先、パスワードリセットメールのリンク先に使う
FRONTEND_URL=http://localhost:4000
# 本番フロントの URL（CORS の許可元に追加される。ローカルでは空でよい）
FRONTEND_URL_PROD=

# ローカルで Docker を使わず起動する場合の DB 接続先（database.yml の既定値と同じ）
# DB_HOST=localhost
# DB_PORT=5433

# メールの差出人（未設定なら noreply@otterbank.example.com）
# MAILER_FROM=noreply@example.com

# 本番のみ: SMTP の接続先（開発は letter_opener でブラウザに開くため不要）
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
